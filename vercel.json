{
  "rewrites": [
    {
      "source": "/r/:token",
      "destination": "/api/bridge/:token"
    }
  ],
  "functions": {
    "api/queues/missed-call-recovery.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "missed-call-recovery",
          "retryAfterSeconds": 135,
          "maxDeliveries": 6
        }
      ]
    },
    "api/queues/ai-conversation-reply.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "ai-conversation-reply",
          "retryAfterSeconds": 135,
          "maxDeliveries": 8
        }
      ]
    }
  }
}
