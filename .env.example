# --- Supabase / PostgreSQL ---
# Connection used by the running app. In Supabase: Project Settings ->
# Database -> Connection string.
#   Local development (npm run dev, long-running server):
#     "Session" pooler, port 5432, no extra parameters, e.g.
#     postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres
#   Vercel / serverless (set in the Vercel project, not here):
#     "Transaction" pooler, port 6543, with ?pgbouncer=true&connection_limit=1
# The transaction pooler from a local machine makes every Prisma query cost
# several round trips (~1 s each from far away) — see README "Database connections".
DATABASE_URL=

# Used by Prisma Migrate (schema.prisma directUrl). Always the "Session"
# pooler, port 5432 — never the transaction pooler.
DIRECT_URL=

# --- Sessions ---
# Long, random secret used to derive session token hashes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# --- App ---
NODE_ENV=development
# Public base URL of the app. Also the origin of the SMS recovery bridge links
# (MCR-6: https://<APP_URL>/r/<token>). Production must be https on a real host,
# otherwise the SMS bridge route is not offered.
APP_URL=http://localhost:5173

# --- AI Core (Prompt 09) ---
# Both optional. If OPENAI_API_KEY is unset, the app automatically falls
# back to a deterministic mock AI provider (no external calls, no network
# access) rather than failing — see src/server/ai/aiProviderFactory.ts.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Missed call recovery trigger (MCR-4.1) ---
# No variables. On a Vercel deployment the recovery job is published to the
# Vercel Queues topic "missed-call-recovery" (vercel.json) and authenticated
# with the deployment's OIDC token, which Vercel manages — never set or
# commit a queue token. Locally (no VERCEL_DEPLOYMENT_ID) nothing is
# published: READY calls are processed by POST /api/internal/recovery/process
# (Authorization: Bearer $RECOVERY_PROCESSOR_SECRET).
RECOVERY_PROCESSOR_SECRET=

# --- SMS transport (MCR-7A) ---
# "mobizon" = real Mobizon Kazakhstan API; "mock" = development/test only.
# Unset: mock outside production, NO SMS in production (fail closed). With
# "mobizon" but no MOBIZON_API_KEY the SMS channel is unavailable — never mock.
SMS_PROVIDER=
# Mobizon API key (Панель управления → API). Secret: set it in Vercel, never here.
MOBIZON_API_KEY=
# Optional. Only https://api.mobizon.<tld> is accepted; default https://api.mobizon.kz
MOBIZON_API_BASE_URL=
# Optional sender ("from"): a shared or registered alphaname of the AUTOSERVISE
# Mobizon account. Unset = the account's default sender.
MOBIZON_SENDER=
# Secret key of the Mobizon webhook "Статусы SMS" (format json) pointing at
# https://<APP_URL>/api/webhooks/channels/mobizon. Without it every report is refused.
MOBIZON_WEBHOOK_SECRET=
# Optional short FIRST-PARTY origin for SMS bridge links (same deployment),
# e.g. https://<short-domain>. Shorter links = fewer SMS segments. Unset = APP_URL.
RECOVERY_LINK_BASE_URL=

# --- WhatsApp transport: Twilio pilot (MCR-7B1) ---
# One AUTOSERVISE-controlled Twilio account. Secrets: set them in Vercel only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Which provisioned WhatsApp senders belong to which business (server is the
# authority; an owner can only connect the sender assigned to their business):
#   TWILIO_WHATSAPP_SENDERS=+77272500100=<businessId>,+77172500200=<businessId>
TWILIO_WHATSAPP_SENDERS=
# Optional: approved Content Template (HX…) for MISSED_CALL_RECOVERY_V1. Unset =
# no business-initiated WhatsApp recovery (new callers get the SMS bridge).
TWILIO_TEMPLATE_MISSED_CALL_RECOVERY_V1=
# Webhooks (configure on the WhatsApp sender in Twilio Console), exactly:
#   https://<APP_URL>/api/webhooks/channels/twilio/inbound   (incoming messages)
#   https://<APP_URL>/api/webhooks/channels/twilio/status    (set per message automatically)
