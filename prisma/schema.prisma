generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TenantStatus {
  trial
  active
  suspended
  cancelled
}

enum UserRole {
  owner
  admin
  manager
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum KnowledgeCategory {
  FAQ
  SERVICE_INFO
  POLICY
  WARRANTY
  PAYMENT
  PREPARATION
  GENERAL
}

enum BusinessRuleCategory {
  APPOINTMENT
  SERVICE
  PAYMENT
  WARRANTY
  CUSTOMER
  OPERATIONS
  GENERAL
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  QUALIFIED
  WON
  LOST
}

enum LeadSource {
  MANUAL
  WEBSITE
  PHONE
  OTHER
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum CustomerRequestSource {
  PHONE
  WEBSITE
  MANUAL
  OTHER
}

enum CustomerRequestStatus {
  NEW
  IN_PROGRESS
  WAITING_CUSTOMER
  QUALIFIED
  CONVERTED
  CLOSED
  CANCELLED
}

// A channel is only a label for where a Conversation came from — no
// external integration exists for any of these yet (see Prompt 08 scope).
enum ConversationChannel {
  MANUAL
  WEBSITE
  TELEGRAM
  WHATSAPP
  PHONE
  OTHER
}

enum ConversationStatus {
  OPEN
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageSenderType {
  CUSTOMER
  STAFF
  SYSTEM
}

enum AiEscalationStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

// LOW/HIGH/URGENT exist for future use (see escalationService.ts's
// derivePriority() — Prompt 12 deliberately maps every AI-created
// escalation to NORMAL, since no safe, tested signal for elevating
// priority exists yet; see AI_BEHAVIOR_CONTRACT.md).
enum AiEscalationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// What kind of AI/staff event this log row records — see AiLog below.
// Deliberately this exact set, no more: one value per event this project
// actually produces today (aiService.ts for the first two, escalation
// create/reuse from within escalationService.ts's own
// createOrReuseActiveEscalation(), and the three staff actions from
// escalationService.ts's claim/resolve/cancel).
enum AiLogOperation {
  AI_ANALYZE
  AI_TOOL_EXECUTION
  AI_ESCALATION_CREATE
  AI_ESCALATION_REUSE
  AI_ESCALATION_CLAIM
  AI_ESCALATION_RESOLVE
  AI_ESCALATION_CANCEL
}

// What actually happened, independent of which operation it was —
// see aiLogService.ts for the exact mapping used for each operation.
enum AiLogOutcome {
  SUCCESS
  ESCALATED
  REUSED
  FAILED
  REJECTED
  NO_ACTION
}

model Tenant {
  id        String       @id @default(uuid())
  name      String
  status    TenantStatus @default(trial)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users                          User[]
  businesses                     Business[]
  services                       Service[]
  knowledgeItems                 KnowledgeItem[]
  businessRules                  BusinessRule[]
  customers                      Customer[]
  vehicles                       Vehicle[]
  leads                          Lead[]
  appointments                   Appointment[]
  serviceRecords                 ServiceRecord[]
  customerRequests               CustomerRequest[]
  customerRequestStatusHistories CustomerRequestStatusHistory[]
  conversations                  Conversation[]
  messages                       Message[]
  aiEscalations                  AiEscalation[]
  aiLogs                         AiLog[]

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(owner)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant                         Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions                       Session[]
  customerRequestStatusHistories CustomerRequestStatusHistory[]
  assignedEscalations            AiEscalation[]
  aiLogActions                   AiLog[]

  @@index([tenantId])
  @@map("users")
}

model Business {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  phone       String?
  email       String?
  address     String?
  timezone    String   @default("UTC")
  website     String?
  currency    String   @default("RUB")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant                         Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workingHours                   BusinessWorkingHours[]
  services                       Service[]
  knowledgeItems                 KnowledgeItem[]
  businessRules                  BusinessRule[]
  customers                      Customer[]
  vehicles                       Vehicle[]
  leads                          Lead[]
  appointments                   Appointment[]
  serviceRecords                 ServiceRecord[]
  customerRequests               CustomerRequest[]
  customerRequestStatusHistories CustomerRequestStatusHistory[]
  conversations                  Conversation[]
  messages                       Message[]
  aiEscalations                  AiEscalation[]
  aiLogs                         AiLog[]

  @@index([tenantId])
  @@map("businesses")
}

model BusinessWorkingHours {
  id         String    @id @default(uuid())
  businessId String
  dayOfWeek  DayOfWeek
  isOpen     Boolean   @default(true)
  // Local wall-clock time as "HH:mm" (e.g. "09:00"). Null when isOpen = false.
  // Interpreted using Business.timezone; not a Date/UTC value.
  openTime   String?
  closeTime  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, dayOfWeek])
  @@index([businessId])
  @@map("business_working_hours")
}

model Service {
  id              String   @id @default(uuid())
  tenantId        String
  businessId      String
  name            String
  description     String?
  // Money as Decimal, never Float. Serialized to the API as fixed-point
  // strings (e.g. "1500.00"), never as floating-point numbers.
  priceFrom       Decimal? @db.Decimal(10, 2)
  priceTo         Decimal? @db.Decimal(10, 2)
  currency        String
  durationMinutes Int
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  leads            Lead[]
  appointments     Appointment[]
  serviceRecords   ServiceRecord[]
  customerRequests CustomerRequest[]

  @@index([tenantId])
  @@index([businessId])
  @@index([isActive])
  @@index([businessId, isActive])
  @@map("services")
}

model KnowledgeItem {
  id         String            @id @default(uuid())
  tenantId   String
  businessId String
  title      String
  content    String
  category   KnowledgeCategory @default(GENERAL)
  isActive   Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([tenantId, businessId])
  @@index([tenantId, businessId, isActive])
  @@index([tenantId, businessId, category])
  @@map("knowledge_items")
}

model BusinessRule {
  id          String               @id @default(uuid())
  tenantId    String
  businessId  String
  name        String
  description String
  category    BusinessRuleCategory @default(GENERAL)
  // Lower number = higher priority. 0 = highest, 100 = lowest, 50 = default.
  priority    Int                  @default(50)
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([tenantId, businessId])
  @@index([tenantId, businessId, isActive])
  @@index([tenantId, businessId, category])
  @@index([tenantId, businessId, priority])
  @@map("business_rules")
}

model Customer {
  id         String   @id @default(uuid())
  tenantId   String
  businessId String
  firstName  String
  lastName   String?
  phone      String
  // Normalized lowercase. Duplicate active-customer emails within a
  // Business are rejected at the service layer (not a DB unique
  // constraint, since email is optional and multiple inactive/legacy
  // records may share one).
  email      String?
  notes      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  vehicles         Vehicle[]
  leads            Lead[]
  appointments     Appointment[]
  serviceRecords   ServiceRecord[]
  customerRequests CustomerRequest[]
  conversations    Conversation[]
  escalations      AiEscalation[]

  @@index([tenantId, businessId])
  @@index([tenantId, businessId, isActive])
  @@index([tenantId, businessId, email])
  @@map("customers")
}

model Vehicle {
  id           String   @id @default(uuid())
  tenantId     String
  businessId   String
  customerId   String
  make         String
  model        String
  year         Int?
  // Normalized uppercase.
  licensePlate String?
  // Normalized uppercase.
  vin          String?
  // Kilometers (this app's standard unit; no separate unit field).
  mileage      Int?
  notes        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Restrict, not Cascade: a domain record (Vehicle) is never deleted
  // just because its Customer is soft-deleted elsewhere in the app.
  customer         Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  leads            Lead[]
  appointments     Appointment[]
  serviceRecords   ServiceRecord[]
  customerRequests CustomerRequest[]

  @@index([tenantId, businessId])
  @@index([tenantId, businessId, customerId])
  @@index([tenantId, businessId, isActive])
  @@map("vehicles")
}

model Lead {
  id          String     @id @default(uuid())
  tenantId    String
  businessId  String
  customerId  String
  vehicleId   String?
  serviceId   String?
  status      LeadStatus @default(NEW)
  source      LeadSource @default(MANUAL)
  subject     String
  description String?
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Restrict/SetNull, not Cascade: a Lead's history must survive even if
  // the Customer/Vehicle/Service it references is later removed from the
  // database outside the app's normal soft-delete workflow.
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicle  Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  service  Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([tenantId, businessId])
  @@index([tenantId, businessId, status])
  @@index([tenantId, businessId, customerId])
  @@index([tenantId, businessId, createdAt])
  @@map("leads")
}

model Appointment {
  id         String            @id @default(uuid())
  tenantId   String
  businessId String
  customerId String
  vehicleId  String
  serviceId  String
  // Stored in UTC. Business.timezone (not stored here) is the sole source
  // of truth for interpreting these as local wall-clock time — see
  // src/server/lib/timezone.ts's toBusinessLocalDateTime().
  startAt    DateTime
  endAt      DateTime
  status     AppointmentStatus @default(SCHEDULED)
  notes      String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Restrict, not Cascade: an Appointment is history and must survive even
  // if the Customer/Vehicle/Service it references is later removed from
  // the database outside the app's normal soft-delete workflow.
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  serviceRecords   ServiceRecord[]
  customerRequests CustomerRequest[]

  @@index([tenantId, businessId])
  @@index([tenantId, businessId, startAt])
  @@index([tenantId, businessId, customerId])
  @@index([tenantId, businessId, vehicleId])
  @@index([tenantId, businessId, status])
  @@map("appointments")
}

model ServiceRecord {
  id            String  @id @default(uuid())
  tenantId      String
  businessId    String
  customerId    String
  vehicleId     String
  serviceId     String
  // Optional: a ServiceRecord can document historical work performed
  // before this app was used, with no Appointment behind it (see §9).
  appointmentId String?

  // Stored in UTC, same convention as Appointment.startAt/endAt.
  // Displayed to the client in Business.timezone; no separate timezone
  // field is stored here.
  performedAt DateTime

  // Kilometers, same unit/bounds as Vehicle.mileage. Enforced
  // non-decreasing per vehicle among non-archived records — see
  // assertMileageIsNotDecreasing() in serviceRecordService.ts.
  mileage Int?

  // Money as Decimal, never Float — same principle as Service.priceFrom/
  // priceTo, serialized to the API as a fixed-point string.
  totalPrice Decimal @db.Decimal(12, 2)
  currency   String

  workDescription  String  @db.Text
  partsDescription String? @db.Text
  recommendations  String? @db.Text
  notes            String? @db.Text

  // The only mutable business state on a ServiceRecord. There is no
  // separate status field and no hard delete — a completed service visit
  // is a historical fact; archiving only hides it from the default list.
  isArchived Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Restrict, not Cascade, on every domain relation below — matching
  // Lead/Appointment's treatment of the same entities: a ServiceRecord is
  // permanent history and must survive the Customer/Vehicle/Service/
  // Appointment it references being deactivated, changed, or (outside the
  // app's normal soft-delete workflow) removed.
  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicle     Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  service     Service      @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Restrict)

  @@index([tenantId, businessId])
  @@index([tenantId, businessId, performedAt])
  @@index([tenantId, businessId, isArchived])
  @@index([vehicleId, performedAt])
  @@index([customerId, performedAt])
  @@index([serviceId, performedAt])
  @@index([appointmentId])
  @@map("service_records")
}

model CustomerRequest {
  id            String  @id @default(uuid())
  tenantId      String
  businessId    String
  customerId    String
  vehicleId     String?
  serviceId     String?
  // Optional link to the Appointment this request turned into (see
  // CONVERTED in CustomerRequestStatus). Can also be set before the status
  // reflects it — connecting the appointment and changing the status are
  // two deliberate, separate actions (see assertRelations/§17 in
  // customerRequestService.ts).
  appointmentId String?

  source CustomerRequestSource @default(MANUAL)
  status CustomerRequestStatus @default(NEW)

  subject     String
  description String?

  // The customer's wanted local *date* — never a specific instant, never
  // Appointment.startAt. Normalized to UTC midnight of the calendar date it
  // falls on in Business.timezone (the app's sole timezone source) before
  // being stored — see normalizeRequestedDate() in customerRequestService.ts.
  requestedDate     DateTime?
  // "HH:mm", zero-padded, same convention as BusinessWorkingHours.openTime/
  // closeTime — a wall-clock time in Business.timezone, not a Date/UTC value.
  requestedTimeFrom String?
  requestedTimeTo   String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Restrict, not Cascade, on every domain relation below — same principle
  // as Lead/Appointment/ServiceRecord: a CustomerRequest is a historical
  // record of an inquiry and must survive the Customer/Vehicle/Service/
  // Appointment it references being deactivated, changed, or (outside the
  // app's normal soft-delete workflow) removed.
  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicle     Vehicle?     @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  service     Service?     @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Restrict)

  statusHistory CustomerRequestStatusHistory[]
  conversations Conversation[]

  @@index([tenantId, businessId])
  @@index([tenantId, businessId, status])
  @@index([tenantId, businessId, createdAt])
  @@index([customerId, createdAt])
  @@index([vehicleId, createdAt])
  @@index([appointmentId])
  @@map("customer_requests")
}

model CustomerRequestStatusHistory {
  id                String                 @id @default(uuid())
  tenantId          String
  businessId        String
  customerRequestId String
  fromStatus        CustomerRequestStatus?
  toStatus          CustomerRequestStatus
  changedByUserId   String?
  createdAt         DateTime               @default(now())

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  business        Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerRequest CustomerRequest @relation(fields: [customerRequestId], references: [id], onDelete: Restrict)
  // SetNull, not Restrict: the audit trail is a permanent record and must
  // survive a User being removed, even though there is no user-delete flow
  // in the app today — same principle as Lead.vehicleId/serviceId's SetNull.
  changedByUser   User?           @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, businessId, customerRequestId, createdAt])
  @@index([customerRequestId, createdAt])
  @@map("customer_request_status_history")
}

model Conversation {
  id         String @id @default(uuid())
  tenantId   String
  businessId String

  // Both optional: the very first message of a conversation may arrive
  // before the customer is identified at all ("how much is an oil
  // change?"), and a Conversation may never end up linked to a
  // CustomerRequest. When both are set, customerRequest.customerId must
  // equal customerId — enforced in conversationService.ts, not the DB.
  customerId        String?
  customerRequestId String?

  // A label for where the conversation came from — not a live
  // integration. No channel has an external connection in this codebase.
  channel ConversationChannel
  status  ConversationStatus  @default(OPEN)

  subject String?

  // When the conversation began. Defaults to the creation instant if not
  // given explicitly, but is a distinct field from createdAt so a
  // conversation can be backfilled with a real historical start time.
  startedAt DateTime

  // Set (and kept in sync) whenever a Message is created — see
  // messageRepository.createAndTouchConversation(). Null until the first
  // message exists.
  lastMessageAt DateTime?

  // Set when status transitions to CLOSED (explicit value honored if
  // given, otherwise now()); cleared back to null on every transition to
  // OPEN. See assertStatusChange() in conversationService.ts.
  closedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Restrict, not Cascade: same principle as CustomerRequest's own optional
  // Vehicle/Service/Appointment relations — a Conversation is a historical
  // communication record and must survive its Customer/CustomerRequest
  // being removed outside the app's normal workflow (neither has a
  // hard-delete path today).
  customer        Customer?        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerRequest CustomerRequest? @relation(fields: [customerRequestId], references: [id], onDelete: Restrict)

  messages    Message[]
  escalations AiEscalation[]
  aiLogs      AiLog[]

  @@index([tenantId, businessId])
  @@index([tenantId, businessId, status])
  @@index([tenantId, businessId, channel])
  @@index([tenantId, businessId, lastMessageAt])
  @@index([customerId])
  @@index([customerRequestId])
  @@map("conversations")
}

model Message {
  id             String            @id @default(uuid())
  tenantId       String
  businessId     String
  conversationId String
  direction      MessageDirection
  senderType     MessageSenderType
  content        String            @db.Text
  createdAt      DateTime          @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Cascade — unlike every other domain relation added in this schema so
  // far. A Message only exists as part of its Conversation (it doesn't
  // reference an independent CRM entity the way Lead/Appointment/
  // ServiceRecord/CustomerRequest do), so it is an "owned child" record —
  // the same relationship BusinessWorkingHours has to Business. There is
  // no DELETE endpoint for Conversation today, so this only matters for
  // direct DB operations outside the app's normal flow.
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  aiLogs AiLog[]

  @@index([tenantId, businessId, conversationId, createdAt])
  @@index([conversationId, createdAt])
  @@map("messages")
}

// The persisted form of the AI's `needsHuman: true` signal (Prompt 09) —
// turns a transient result field into a real, tenant-isolated handoff
// workflow. Created/reused by escalationService.ts only; the AI itself
// never gets Prisma access and never resolves/cancels/assigns one (see
// AI_BEHAVIOR_CONTRACT.md §10).
model AiEscalation {
  id         String @id @default(uuid())
  tenantId   String
  businessId String

  // The permanent, immutable reference to which Conversation this
  // escalation is about — never changes after creation.
  conversationId String
  // Denormalized from Conversation.customerId at creation time (nullable,
  // same as Conversation's own field) — a Conversation can still be
  // escalated before a customer is identified.
  customerId String?

  status   AiEscalationStatus
  priority AiEscalationPriority @default(NORMAL)

  // Always server-derived from the validated AI result (never client- or
  // model-supplied as free text) — see escalationService.ts's
  // deriveReason(). Bounded length, enforced in the Zod-validated internal
  // input type, not by an untrusted API body.
  reason String
  // Optional staff-facing convenience text — never the raw provider
  // response, never chain-of-thought, never a prompt. Null when no safe
  // summary is available.
  summary String?

  assignedUserId String?

  // Mirrors `conversationId` while status is OPEN/IN_PROGRESS, and is
  // forced back to null the moment the escalation leaves that active
  // window (RESOLVED/CANCELLED). Combined with the @@unique below, this is
  // a standard nullable-column technique that gives Postgres a REAL,
  // database-enforced "at most one active escalation per conversation"
  // guarantee — Postgres treats every NULL as distinct from every other
  // NULL, so any number of RESOLVED/CANCELLED rows for the same
  // conversation can coexist, but at most one row can ever hold this
  // conversation as active at a time. Prisma's schema DSL cannot express a
  // partial/filtered unique index directly, so this is the safe,
  // fully-declarative equivalent — see escalationService.ts's
  // createOrReuseActive() for how a concurrent duplicate is handled (the
  // constraint is the actual authority; an application-level check is only
  // a fast path). Never read or written directly outside this file's
  // repository — always kept in lockstep with `status`.
  activeConversationId String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  // Set only when status transitions to RESOLVED, server-side, from
  // server time — never a client-supplied value. CANCELLED deliberately
  // does NOT set this field (see escalationService.ts's STEP 23 note) —
  // resolvedAt means "actually resolved," not "closed for any reason."
  resolvedAt DateTime?

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Restrict, not Cascade: an escalation is a historical record of a human
  // handoff and must survive its Conversation/Customer being removed
  // outside the app's normal workflow (neither has a hard-delete path
  // today) — same principle as every other domain relation in this schema.
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  // SetNull, not Restrict: the escalation itself must survive a User being
  // removed, even though there is no user-delete flow in the app today —
  // same principle as CustomerRequestStatusHistory.changedByUserId.
  assignedUser User?        @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)

  aiLogs AiLog[]

  @@unique([tenantId, businessId, activeConversationId])
  @@index([tenantId, businessId])
  @@index([tenantId, businessId, status])
  @@index([tenantId, businessId, priority])
  @@index([conversationId])
  @@index([customerId])
  @@index([assignedUserId])
  @@index([createdAt])
  @@map("ai_escalations")
}

// A safe, minimal audit trail of AI/staff events (Prompt 13) — never a
// substitute for Conversation/Message (the actual transcript) or a
// dashboard/analytics feature (Roadmap 14). Written exclusively by
// aiLogService.ts, which is the one place that decides what is safe to
// persist here — the AI itself never gets Prisma access, and nothing in
// this model may ever hold chain-of-thought, hidden reasoning, a raw
// provider response, a full prompt, a full Message/transcript, or any
// secret/credential (see aiLogService.ts's sanitizeMetadata() and
// AI_BEHAVIOR_CONTRACT.md's logging/privacy boundary).
model AiLog {
  id         String @id @default(uuid())
  tenantId   String
  businessId String

  // All optional: not every operation this model records is about a
  // Conversation/Message/Escalation/staff member specifically — e.g. a
  // provider/configuration failure log still has a conversationId (it
  // happened during one specific analyze() call) but no escalation.
  conversationId String?
  messageId      String?
  escalationId   String?
  // The staff member who performed the action, for the three
  // AI_ESCALATION_CLAIM/RESOLVE/CANCEL operations only — null for every
  // AI-driven operation (AI_ANALYZE, AI_TOOL_EXECUTION,
  // AI_ESCALATION_CREATE/REUSE), since those aren't a human's action.
  actorUserId String?

  operation AiLogOperation
  outcome   AiLogOutcome

  // Mirrors the validated AiResult fields for AI_ANALYZE rows only — null
  // for every other operation. Never the model's own free-form text
  // beyond what aiResultSchema already validates.
  intent     String?
  confidence Float?
  needsHuman Boolean?

  // A short, safe, server-derived explanation — never model chain-of-
  // thought, never a raw provider explanation, bounded to 500 chars by
  // aiLogService.ts before this row is ever written.
  reason String?

  // For AI_TOOL_EXECUTION rows only.
  toolName    String?
  toolSuccess Boolean?

  // Small, structured, whitelisted-shape technical data only (e.g.
  // {"provider":"mock","toolCallCount":2} or {"errorCode":"APPOINTMENT_CONFLICT"})
  // — see aiLogService.ts's sanitizeMetadata(). Never raw provider output,
  // never a prompt, never PII beyond what's already reachable via the FKs
  // above.
  metadata Json?

  createdAt DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Restrict on every optional domain relation, same principle as
  // AiEscalation: an audit record is itself a historical fact and must
  // survive the thing it's about being removed outside the app's normal
  // workflow (none of Conversation/Message/AiEscalation has a hard-delete
  // path today, so this is defensive, matching the rest of the schema).
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  message      Message?      @relation(fields: [messageId], references: [id], onDelete: Restrict)
  escalation   AiEscalation? @relation(fields: [escalationId], references: [id], onDelete: Restrict)
  // SetNull, not Restrict: the audit trail must survive a User being
  // removed, even though there is no user-delete flow today — same
  // principle as AiEscalation.assignedUserId / CustomerRequestStatusHistory.changedByUserId.
  actorUser User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, businessId])
  @@index([tenantId, businessId, createdAt])
  @@index([conversationId, createdAt])
  @@index([escalationId, createdAt])
  @@index([operation, createdAt])
  @@index([outcome, createdAt])
  @@map("ai_logs")
}

model Session {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("sessions")
}
