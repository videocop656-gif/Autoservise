generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TenantStatus {
  trial
  active
  suspended
  cancelled
}

enum UserRole {
  owner
  admin
  manager
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model Tenant {
  id        String       @id @default(uuid())
  name      String
  status    TenantStatus @default(trial)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users      User[]
  businesses Business[]
  services   Service[]

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(owner)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@index([tenantId])
  @@map("users")
}

model Business {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  phone       String?
  email       String?
  address     String?
  timezone    String   @default("UTC")
  website     String?
  currency    String   @default("RUB")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workingHours BusinessWorkingHours[]
  services     Service[]

  @@index([tenantId])
  @@map("businesses")
}

model BusinessWorkingHours {
  id         String    @id @default(uuid())
  businessId String
  dayOfWeek  DayOfWeek
  isOpen     Boolean   @default(true)
  // Local wall-clock time as "HH:mm" (e.g. "09:00"). Null when isOpen = false.
  // Interpreted using Business.timezone; not a Date/UTC value.
  openTime   String?
  closeTime  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, dayOfWeek])
  @@index([businessId])
  @@map("business_working_hours")
}

model Service {
  id              String   @id @default(uuid())
  tenantId        String
  businessId      String
  name            String
  description     String?
  // Money as Decimal, never Float. Serialized to the API as fixed-point
  // strings (e.g. "1500.00"), never as floating-point numbers.
  priceFrom       Decimal? @db.Decimal(10, 2)
  priceTo         Decimal? @db.Decimal(10, 2)
  currency        String
  durationMinutes Int
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([businessId])
  @@index([isActive])
  @@index([businessId, isActive])
  @@map("services")
}

model Session {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("sessions")
}
